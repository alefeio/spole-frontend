# API Spolê — porta padrão do backend (ver /api/.env.example: PORT=3000).
# Use o host que o *navegador* consegue alcançar: em WSL/rede, `localhost` no browser
# pode não apontar para o mesmo Postgres/API que o seed; prefira o IP/host real (ex.: http://172.x.x.x:3000).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Opcional (dev): se o WebSocket do HMR falhar ao abrir o app por IP (ex. 172.x), tente acessar por
# http://localhost:PORT ou ajuste firewall/proxy para upgrade WebSocket em `/_next/webpack-hmr`.

